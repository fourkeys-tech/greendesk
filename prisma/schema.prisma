generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PENGGUNA
  PENGELOLA
  MANAGER
  PIC_VENDOR
  TEKNISI
  ADMIN
  OWNER
}

enum ReportStatus {
  BARU
  DIBATALKAN
  DIGABUNG
  TIDAK_VALID
  MENUNGGU_KEPUTUSAN
  DITOLAK
  DISETUJUI
  DIKERJAKAN
  MENUNGGU_KONFIRMASI
  SELESAI
}

enum Priority {
  TINGGI
  NORMAL
  RENDAH
}

enum Channel {
  QR
  DASHBOARD
}

enum VendorType {
  INTERNAL
  EXTERNAL
}

enum TechnicianStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkPhotoType {
  BEFORE
  AFTER
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  BLOCK
  UNBLOCK
}

enum VendorReplacementStatus {
  DIAJUKAN
  DITOLAK
  DISETUJUI
  DITERUSKAN_KE_OWNER
}

model Company {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  contact   String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  complexes     Complex[]
  clusters      Cluster[]
  parks         Park[]
  categories    Category[]
  assets        Asset[]
  users         User[]
  vendors       Vendor[]
  technicians   Technician[]
  reports       Report[]
  workOrders    WorkOrder[]
  vendorReplacements VendorReplacementRequest[]
  auditLogs     AuditLog[]
  notifications Notification[]
  emailLogs     EmailLog[]
}

model Complex {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clusters Cluster[]

  @@index([companyId])
}

model Cluster {
  id        String   @id @default(cuid())
  companyId String
  complexId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  complex            Complex                    @relation(fields: [complexId], references: [id], onDelete: Restrict)
  parks              Park[]
  staffUsers         User[]                     @relation("ClusterStaff")
  managerAssignments ClusterManagerAssignment[]
  vendorServiceAreas VendorServiceArea[]
  vendorReplacements VendorReplacementRequest[]

  @@index([companyId])
  @@index([complexId])
}

model Park {
  id           String   @id @default(cuid())
  companyId    String
  clusterId    String
  name         String
  locationNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  assets  Asset[]

  @@index([companyId])
  @@index([clusterId])
}

model Category {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  damageTypes String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assets  Asset[]

  @@index([companyId])
}

model Asset {
  id           String    @id @default(cuid())
  companyId    String
  code         String    @unique
  parkId       String
  categoryId   String
  name         String
  locationNote String?
  photoUrl     String?
  installedAt  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  park     Park     @relation(fields: [parkId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reports  Report[]
  vendorReplacements VendorReplacementRequest[]

  @@index([companyId])
  @@index([parkId])
  @@index([categoryId])
}

model User {
  id                 String    @id @default(cuid())
  companyId          String?
  name               String
  email              String    @unique
  passwordHash       String?
  role               Role      @default(PENGGUNA)
  loginMethod        String    @default("EMAIL")
  reporterStatus     String?   // "WARGA" | "PENGUNJUNG"
  blockHouseNo       String?
  dataConsentAt      DateTime?
  validReportCount   Int       @default(0)
  invalidReportCount Int       @default(0)
  isBlocked          Boolean   @default(false)
  blockedReason      String?
  isActive           Boolean   @default(true)
  staffClusterId     String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company            Company?                   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  staffCluster       Cluster?                   @relation("ClusterStaff", fields: [staffClusterId], references: [id], onDelete: SetNull)
  managerAssignments ClusterManagerAssignment[]
  managedVendor      Vendor?                    @relation("VendorPIC")
  technicianProfile  Technician?                @relation("TechnicianUser")
  reports            Report[]                   @relation("ReporterReports")
  statusChanges      ReportStatusLog[]
  submittedReplacementRequests VendorReplacementRequest[] @relation("SubmittedReplacementRequests")
  managerDecidedReplacements   VendorReplacementRequest[] @relation("ManagerDecidedReplacements")
  adminForwardedReplacements   VendorReplacementRequest[] @relation("AdminForwardedReplacements")
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([companyId])
  @@index([role])
}

model ClusterManagerAssignment {
  id                String    @id @default(cuid())
  userId            String
  clusterId         String
  isTemporary       Boolean   @default(false)
  replacedManagerId String?
  validFrom         DateTime  @default(now())
  validUntil        DateTime?
  createdAt         DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([userId, clusterId, isTemporary])
  @@index([clusterId])
}

model Vendor {
  id                        String     @id @default(cuid())
  companyId                 String
  name                      String
  type                      VendorType @default(EXTERNAL)
  skills                    String[]
  picUserId                 String?    @unique
  cooperationScheme         String?
  contractStart             DateTime?
  contractEnd               DateTime?
  warrantyDays              Int        @default(30)
  address                   String?
  npwp                      String?
  isActive                  Boolean    @default(true)
  lastTechnicianConfirmedAt DateTime?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  picUser        User?               @relation("VendorPIC", fields: [picUserId], references: [id], onDelete: SetNull)
  serviceAreas   VendorServiceArea[]
  technicians    Technician[]
  workOrders     WorkOrder[]
  warrantyClaimReports Report[]      @relation("WarrantyVendor")
  replacementRequests  VendorReplacementRequest[]

  @@index([companyId])
}

model VendorServiceArea {
  id        String @id @default(cuid())
  vendorId  String
  clusterId String

  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  cluster Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([vendorId, clusterId])
}

model Technician {
  id             String           @id @default(cuid())
  companyId      String
  vendorId       String
  userId         String           @unique
  fullName       String
  whatsapp       String
  email          String
  facePhotoUrl   String?
  skills         String[]
  status         TechnicianStatus @default(ACTIVE)
  approvalStatus ApprovalStatus   @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  deactivationReason    String? // AUTO_60_DAYS | MANUAL_BY_PIC | MANUAL_BY_ADMIN
  reactivationRequested Boolean  @default(false)
  reactivationNote      String?
  lastActiveAt   DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  user       User        @relation("TechnicianUser", fields: [userId], references: [id], onDelete: Cascade)
  workOrders WorkOrder[]

  @@index([companyId])
  @@index([vendorId])
}

model Report {
  id                      String       @id @default(cuid())
  companyId               String
  ticketNo                String       @unique
  assetId                 String
  reporterId              String
  channel                 Channel      @default(QR)
  description             String
  status                  ReportStatus @default(BARU)
  priority                Priority?
  reason                  String?
  parentReportId          String?
  underWarrantyOfVendorId String?
  archivedAt              DateTime?
  stageEnteredAt          DateTime     @default(now())
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  company               Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  asset                 Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reporter              User              @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Restrict)
  parentReport          Report?           @relation("MergedReports", fields: [parentReportId], references: [id], onDelete: SetNull)
  mergedChildReports    Report[]          @relation("MergedReports")
  underWarrantyOfVendor Vendor?           @relation("WarrantyVendor", fields: [underWarrantyOfVendorId], references: [id], onDelete: SetNull)
  photos                ReportPhoto[]
  statusLogs            ReportStatusLog[]
  workOrder             WorkOrder?

  @@index([companyId, archivedAt])
  @@index([assetId])
  @@index([reporterId])
  @@index([status])
}

model ReportPhoto {
  id        String   @id @default(cuid())
  reportId  String
  url       String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ReportStatusLog {
  id          String        @id @default(cuid())
  reportId    String
  fromStatus  ReportStatus?
  toStatus    ReportStatus
  changedById String
  note        String?
  createdAt   DateTime      @default(now())

  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([reportId])
}

model WorkOrder {
  id           String    @id @default(cuid())
  companyId    String
  spkNo        String    @unique
  reportId     String    @unique
  vendorId     String
  technicianId String?
  spkFileUrl          String?
  spkFileName         String?
  spkFileSize         Int?
  spkFileMime         String?
  spkFileUploadedAt   DateTime?
  spkFileUploadedById String?
  assignedAt   DateTime?
  completedAt  DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  report        Report         @relation(fields: [reportId], references: [id], onDelete: Restrict)
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  technician    Technician?    @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  revisionNotes RevisionNote[]
  photos        WorkPhoto[]

  @@index([companyId])
  @@index([vendorId])
  @@index([technicianId])
}

model WorkPhoto {
  id           String        @id @default(cuid())
  workOrderId  String
  type         WorkPhotoType
  url          String
  uploadedById String
  createdAt    DateTime      @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model RevisionNote {
  id          String   @id @default(cuid())
  workOrderId String
  note        String
  createdById String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String      @id @default(cuid())
  companyId  String?
  actorId    String?
  actorName  String
  actorRole  Role
  entityName String
  entityId   String
  action     AuditAction
  summary    String
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime    @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entityName, entityId])
}

model Notification {
  id          String   @id @default(cuid())
  companyId   String?
  recipientId String
  title       String
  message     String
  linkUrl     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  recipient User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
}

model EmailLog {
  id           String   @id @default(cuid())
  companyId    String?
  toEmail      String
  subject      String
  bodyHtml     String
  triggerType  String
  ticketNo     String?
  status       String   @default("SENT") // SENT, FAILED, QUEUED
  retryCount   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model OtpCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model VendorReplacementRequest {
  id                  String                  @id @default(cuid())
  companyId           String
  requestNo           String                  @unique
  clusterId           String
  assetId             String
  vendorId            String
  basisReportIds      String[]
  reason              String
  status              VendorReplacementStatus @default(DIAJUKAN)
  submittedById       String
  managerDecisionNote String?
  managerDecidedById  String?
  managerDecidedAt    DateTime?
  adminForwardedById  String?
  adminForwardedAt    DateTime?
  adminForwardedNote  String?
  ownerViewedAt       DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  cluster          Cluster  @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  asset            Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  submittedBy      User     @relation("SubmittedReplacementRequests", fields: [submittedById], references: [id], onDelete: Restrict)
  managerDecidedBy User?    @relation("ManagerDecidedReplacements", fields: [managerDecidedById], references: [id], onDelete: SetNull)
  adminForwardedBy User?    @relation("AdminForwardedReplacements", fields: [adminForwardedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clusterId])
  @@index([assetId])
  @@index([status])
}

