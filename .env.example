# Database Connection (PostgreSQL eksternal)
# Contoh: postgresql://postgres:postgres@127.0.0.1:5432/greenpark
# Supabase di Vercel: pakai Transaction Pooler (port 6543), bukan Session Pooler (5432)
DATABASE_URL=""

# Authentication Secret Key (minimum 32 characters)
AUTH_SECRET=""

# Default Password for Local Development Seed Accounts (hanya dipakai db/seed.ts)
SEED_DEFAULT_PASSWORD=""

# URL absolut aplikasi (dipakai tautan cek status di email), contoh: https://greenpark.id
APP_BASE_URL=""

# Secret untuk route cron (/api/cron/outbox, /api/cron/maintenance)
CRON_SECRET=""

# Object storage S3-compatible (Supabase Storage) untuk foto & dokumen unggahan.
# Wajib di Vercel (filesystem read-only). Kosongkan untuk simpan ke public/uploads saat dev lokal.
# Supabase: Project Settings > Storage > S3 Connection. Bucket harus Public.
S3_ENDPOINT=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Bucket PRIVATE untuk dokumen SPK (diunduh lewat /api/spk/[id]/file + presigned URL).
# Kosongkan saat dev lokal -> disimpan di .private-uploads/.
S3_PRIVATE_BUCKET=""
# Opsional: default diturunkan dari endpoint Supabase -> https://<ref>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_BASE_URL=""

# Google OAuth 2.0 (opsional — aktifkan tombol Masuk/Lanjut dengan Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opsional: override callback URL, default: ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# SMTP (kosongkan SMTP_HOST untuk transport console di development)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
